# Copy this file to .env.local and fill in the values.
# No quotes, no spaces around "=". Never commit .env.local.

# Google AI Studio -> Get API key -> Create API key
GEMINI_API_KEY=

# Supabase -> Project Settings -> Data API -> Project URL
# (looks like https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> Publishable key
# (starts with sb_publishable_). Safe in the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase -> Project Settings -> API Keys -> Secret keys
# (starts with sb_secret_). BYPASSES RLS. Server-only:
# never add a NEXT_PUBLIC_ prefix to this one.
SUPABASE_SECRET_KEY=

# Optional, only for `npm run eval`: your user id, which is the
# UUID at the end of your customer chat link (/chat/<this-part>).
EVAL_BUSINESS_ID=
